<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <!-- Attached explicitly. Sitting in source/ puts a function in the main
       thread's scope, NOT in this component's, so without this line every call
       into it fails at runtime with "not defined in component's namespace" and
       nothing says so until that code path is actually taken. -->
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0b0d11ff" />

    <!-- Header -->
    <Label id="brand" text="YARR.IT" translation="[80,52]"
           color="0x5eead4ff" >
      <Font role="font" uri="font:BoldSystemFontFile" size="42" />
    </Label>
    <!-- Status / errors -->
    <Label id="status" translation="[80,1040]" color="0xe9edf3ff" width="1760" wrap="true">
      <Font role="font" uri="font:SystemFontFile" size="28" />
    </Label>

    <!-- Browse grid. MarkupGrid rather than RowList: a flat grid of posters is
         easier to navigate with a D-pad than nested rows. -->
    <!-- vertFocusAnimationStyle is deliberately NOT fixedFocusWrap: wrapping
         makes the grid consume Up on the top row to jump to the bottom, so the
         key never reaches the scene and the filter bar becomes unreachable. -->
    <MarkupGrid id="grid" translation="[80,330]"
                itemComponentName="PosterTile"
                numRows="2" numColumns="6"
                itemSize="[280,420]" itemSpacing="[16,24]"
                vertFocusAnimationStyle="fixedFocus"
                drawFocusFeedback="true" />

    <!-- Filter bar, drawn after the grid so it is never covered by it.
         ButtonGroup because LabelList is vertical-only on Roku;
         this is the node that actually lays out horizontally and gives D-pad
         focus for free. The active filter is echoed in filterEcho, because a
         ButtonGroup shows focus but has no notion of a current selection —
         so once focus returns to the grid there would otherwise be nothing on
         screen saying what is being filtered. -->
    <ButtonGroup id="filterButtons" translation="[80,96]"
                 layoutDirection="horiz" itemSpacings="[10]"
                 minWidth="150" />
    <Label id="filterEcho" translation="[1180,62]" width="660" horizAlign="right" color="0x5eead4ff">
      <Font role="font" uri="font:SystemFontFile" size="22" />
    </Label>


    <!-- Source picker: shown after a title is chosen. -->
    <Group id="sourcePane" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0d11ee" />
      <Label id="sourceTitle" translation="[80,70]" color="0xe9edf3ff" width="1760" wrap="true">
        <Font role="font" uri="font:BoldSystemFontFile" size="40" />
      </Label>
      <Label id="sourceHint" translation="[82,132]" color="0x8b96a8ff">
        <Font role="font" uri="font:SystemFontFile" size="24" />
      </Label>
      <LabelList id="sourceList" translation="[80,190]"
                 itemSize="[1760,64]" numRows="11"
                 color="0xcfd6e0ff" focusedColor="0x5eead4ff"
                 drawFocusFeedback="true">
        <Font role="font" uri="font:SystemFontFile" size="26" />
        <Font role="focusedFont" uri="font:BoldSystemFontFile" size="26" />
      </LabelList>
    </Group>

    <!-- Player -->
    <Video id="player" width="1920" height="1080" translation="[0,0]" visible="false" />

    <!-- Comics and photo sets. A Roku cannot render a PDF and cannot follow an
         archive.org details page, so both arrive as a list of ordinary JPEGs
         and are shown here one at a time. Left/Right turn the page. -->
    <Group id="pageViewer" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000ff" />
      <Poster id="pageImage" translation="[0,0]" width="1920" height="1080"
              loadDisplayMode="limitSize" loadWidth="1920" loadHeight="1080" />
      <Label id="pageCount" translation="[80,1010]" color="0x8b96a8ff" width="1760" />
    </Group>

    <!-- Busy overlay -->
    <Group id="busy" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0d11dd" />
      <Label id="busyText" translation="[80,500]" width="1760" wrap="true"
             color="0xe9edf3ff" horizAlign="center">
        <Font role="font" uri="font:SystemFontFile" size="34" />
      </Label>
    </Group>

    <!-- Sign-in gate. Drawn last so it covers everything: nothing behind it
         is reachable until a real Authentik account has approved this TV. -->
    <Group id="signIn" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0d11ff" />
      <Label text="Sign in to Yarr.It" translation="[160,200]" color="0x5eead4ff">
        <Font role="font" uri="font:BoldSystemFontFile" size="56" />
      </Label>
      <Label id="signInStep1" translation="[160,300]" width="1600" wrap="true" color="0xe9edf3ff">
        <Font role="font" uri="font:SystemFontFile" size="32" />
      </Label>
      <Label id="signInUrl" translation="[160,352]" width="1600" color="0x5eead4ff">
        <Font role="font" uri="font:BoldSystemFontFile" size="46" />
      </Label>
      <Label id="signInCode" translation="[160,450]" width="1600" color="0xffffffff">
        <Font role="font" uri="font:BoldSystemFontFile" size="110" />
      </Label>
      <Label id="signInHint" translation="[160,610]" width="1600" wrap="true" color="0x8b96a8ff">
        <Font role="font" uri="font:SystemFontFile" size="28" />
      </Label>
      <Label id="signInStatus" translation="[160,700]" width="1600" wrap="true" color="0x8b96a8ff">
        <Font role="font" uri="font:SystemFontFile" size="26" />
      </Label>
      <Timer id="pollTimer" repeat="true" duration="5" />
    </Group>

    <!-- Server settings. Drawn after the sign-in gate, and so on top of it, on
         purpose: a TV pointed at a self-hosted Yarr.It still meets the gate
         first, and if settings sat behind it an owner could never reach the one
         screen that fixes a wrong address. It shows no catalogue content, so it
         does not weaken the gate. -->
    <Group id="settings" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0d11ff" />
      <Label text="Server" translation="[160,120]" color="0x5eead4ff">
        <Font role="font" uri="font:BoldSystemFontFile" size="56" />
      </Label>
      <Label text="This TV is getting its catalogue from:" translation="[160,220]" color="0x8b96a8ff">
        <Font role="font" uri="font:SystemFontFile" size="28" />
      </Label>
      <Label id="settingsCurrent" translation="[160,266]" width="1600" color="0xe9edf3ff">
        <Font role="font" uri="font:BoldSystemFontFile" size="42" />
      </Label>
      <Label id="settingsPending" translation="[160,336]" width="1600" wrap="true" color="0xf0b429ff">
        <Font role="font" uri="font:SystemFontFile" size="28" />
      </Label>
      <!-- Shown, not asked for. The gateway is derived from the address above,
           so this line exists to prove where playback will go rather than to
           collect a second URL. -->
      <Label id="settingsGateway" translation="[160,378]" width="1600" color="0x8b96a8ff">
        <Font role="font" uri="font:SystemFontFile" size="24" />
      </Label>
      <!-- floatingFocus, not the fixedFocusWrap an ArrayGrid defaults to: with
           a fixed highlight a five item menu that exactly fills its five rows
           still scrolls under the cursor and wraps the first entry around to
           the bottom, so the menu appears to reorder itself as you arrow down
           it. Here the highlight moves and the list holds still. -->
      <LabelList id="settingsMenu" translation="[160,442]"
                 itemSize="[1600,62]" numRows="5"
                 vertFocusAnimationStyle="floatingFocus"
                 color="0xcfd6e0ff" focusedColor="0x5eead4ff"
                 drawFocusFeedback="true">
        <Font role="font" uri="font:SystemFontFile" size="30" />
        <Font role="focusedFont" uri="font:BoldSystemFontFile" size="30" />
      </LabelList>
      <Label id="settingsResult" translation="[160,790]" width="1600" wrap="true" color="0xe9edf3ff">
        <Font role="font" uri="font:SystemFontFile" size="30" />
      </Label>
      <Label id="settingsHint" translation="[160,930]" width="1600" wrap="true" color="0x8b96a8ff">
        <Font role="font" uri="font:SystemFontFile" size="24" />
      </Label>
    </Group>

    <ApiTask id="api" />
  </children>
</component>
