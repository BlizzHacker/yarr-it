[Unit]
Description=mw-search — search and metadata API for stream.moveweight.com
Documentation=https://github.com/BlizzHacker/yarr-it
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mw-search -addr 127.0.0.1:8802 -prowlarr http://192.168.0.115:9696

# API keys live here, not in the unit and not in the repo. Marked required on
# purpose: without them the service starts but silently answers with empty
# shelves, which looks like a broken frontend rather than missing credentials.
EnvironmentFile=/etc/mw-search.env

Restart=always
RestartSec=2

User=mw-search
Group=mw-search

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# The watchlist and resume points live here. StateDirectory rather than a plain
# path: ProtectSystem=strict mounts the filesystem read-only, so a directory
# created by hand is not writable no matter who owns it. systemd creates this
# one, chowns it to User=, and makes it writable inside the sandbox.
StateDirectory=mw-search
Environment=LIBRARY_PATH=/var/lib/mw-search/library.json
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
