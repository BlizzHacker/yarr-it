{
	email wadeivy11@gmail.com

	# Caddy may hold :80 again. The mail relay's certificate moved to the
	# DNS-01 challenge (certbot --dns-cloudflare), which completes entirely
	# over the Cloudflare API and needs no port at all -- so there is nothing
	# left to contend with. Before that, nothing answered on :80 and anyone
	# typing a bare hostname on a phone got a connection refused, while
	# desktop browsers quietly upgraded to HTTPS and looked fine.
}

yarrit.com, www.yarrit.com {
	# Issue over TLS-ALPN-01, which completes entirely on :443. The HTTP
	# challenge is disabled because taking :80 would break the mail relay's
	# renewal -- see the note above.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode zstd gzip

	# The URL a TV puts on screen for someone to type into a phone. It has to
	# be short enough to read across a room and retype without a mistake, which
	# the identity provider's own hostname is not.
	redir /tv https://auth.yarrit.com/device 302
	redir /tv/ https://auth.yarrit.com/device 302

	# Torrent peer relay (WebSocket). Long-lived connections, no compression.
	handle /bridge* {
		reverse_proxy 127.0.0.1:8801
	}

	# Search / metadata API.
	handle /api/* {
		reverse_proxy 127.0.0.1:8802
	}

	# Sign-in endpoints. These must be reachable WITHOUT a session -- somebody
	# who cannot load the login page can never get through it -- so they are
	# routed before the gate below rather than behind it.
	handle /auth/* {
		reverse_proxy 127.0.0.1:8802
	}

	# No gate here: the site is open. TV clients are required to sign in by
	# mw-search, which can tell a TV from a browser. Set AUTH_SCOPE=all in
	# /etc/mw-search-sso.env to put the whole site back behind sign-in.

	# index.html carries a hashed script URL, so it must never be cached or a
	# returning visitor keeps loading the previous build's assets.
	@html path / /index.html
	header @html Cache-Control "no-cache, must-revalidate"

	# Only app.js carries a content hash in its URL, so only it is safe to cache
	# hard. Caching the other modules pinned stale copies for a week.
	@hashed path /app.js
	header @hashed Cache-Control "public, max-age=604800, immutable"

	@images path *.png *.svg *.webmanifest
	header @images Cache-Control "public, max-age=86400"

	@modules path /engine.js /bridge-peer.js /tracker-udp.js /dht.js /bencode.js /sw.min.js /webtorrent.min.js
	header @modules Cache-Control "no-cache, must-revalidate"

	handle {
		root * /srv/stream/www
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# The engine runs in workers; keep it same-origin isolated.
		Cross-Origin-Opener-Policy "same-origin"
	}

	log {
		output file /var/log/caddy/stream.log
		format json
	}
}

# Yarr.It moved to its own domain, off moveweight.com entirely. This stays for
# the apps already in the field -- Roku, Tizen, the Android wrapper and the
# Windows package all have the old host compiled in, and store updates take
# days to weeks to reach a device. A permanent redirect keeps them working
# until they are rebuilt.
stream.moveweight.com {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	redir https://yarrit.com{uri} permanent
}
