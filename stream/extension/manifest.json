{
  "manifest_version": 3,
  "name": "Yarr.It \u2014 view before you download",
  "short_name": "Yarr.It",
  "version": "1.1.0",
  "description": "Stream any magnet link in your browser, and reach your own home media services from yarrit.com without running a server.",
  "minimum_chrome_version": "116",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Yarr.It \u2014 stream this page's torrents",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "st"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "offscreen",
    "proxy"
  ],
  "host_permissions": [
    "https://yarrit.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://yarrit.com/*",
        "https://www.yarrit.com/*"
      ],
      "js": [
        "relay-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://yarrit.com/*",
        "https://www.yarrit.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "pip.html"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "optional_permissions": [
    "privacy",
    "webRequest",
    "webRequestAuthProvider"
  ]
}
