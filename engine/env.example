# engine/.env -- copy from engine/env.example. Never commit the copy.

# Where media lives on this machine. The engine files films into
# $MEDIA_DIR/movies and series into $MEDIA_DIR/tv.
MEDIA_DIR=./media
DOWNLOADS_DIR=./downloads
ROMS_DIR=./roms

# Optional. Without it the engine uses a free, keyless catalogue (Cinemeta);
# with it, TMDB/TVDB ids from Seerr, Radarr and lists reach the engine too.
TMDB_API_KEY=

# Sign-in. Without it the owner screens (engine, requests, library) stay
# closed: Yarr.It never treats an anonymous visitor as the owner. Any OIDC
# provider (Authentik, Keycloak, Authelia, ...).
SESSION_SECRET=
SSO_BASE=
SSO_APP_SLUG=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
YARRIT_OWNER_EMAIL=

# First boot only: pre-fill the engine's download client. With the bundled
# qBittorrent (--profile downloader) the address is http://qbittorrent:8080;
# its first password is in `docker compose logs qbittorrent`.
# ENGINE_QBIT_URL=http://qbittorrent:8080
# ENGINE_QBIT_USERNAME=admin
# ENGINE_QBIT_PASSWORD=

# --- bring your own (each optional) ------------------------------------------
# A service named here is preferred over the engine for the same job.
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
# RADARR_URL=  RADARR_API_KEY=
# SONARR_URL=  SONARR_API_KEY=
# LIDARR_URL=  LIDARR_API_KEY=
# SEERR_URL=   SEERR_API_KEY=
# GGREQUESTZ_URL=  GGREQUESTZ_API_KEY=
# CINEPHAGE_URL=  CINEPHAGE_API_KEY=      # an existing Cinephage, as a third-party service
# ROMM_URL=  ROMM_USERNAME=  ROMM_PASSWORD=
# JELLYFIN_URL=  JELLYFIN_API_KEY=
# PLEX_URL=  PLEX_TOKEN=
